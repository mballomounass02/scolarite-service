<%- include("../partials/head", {title}) %>
<div class="page-heading"><div><a class="back-link" href="/admin">← Tableau de bord</a><div class="eyebrow">ADMINISTRATION</div><h1>Comptes des <em>agents.</em></h1><p>Créez et consultez les comptes du service de scolarité.</p></div></div>
<div class="two-col"><section class="panel"><h2>Créer un agent</h2><form method="post" action="/admin/agents" class="form-stack"><label>Nom<input name="nom" required></label><label>Prénom<input name="prenom" required></label><label>Adresse e-mail<input type="email" name="email" required></label><label>Mot de passe provisoire<input type="password" name="password" minlength="8" required></label><button class="btn btn-primary btn-block">Créer le compte</button></form></section>
<section class="panel"><h2>Agents enregistrés</h2><% agents.forEach(a=>{ %><div class="agent-row"><div class="avatar"><%= (a.prenom[0]+a.nom[0]).toUpperCase() %></div><div><b><%= a.prenom %> <%= a.nom %></b><small><%= a.email %></small></div><span class="status <%= a.actif?'ok':'no' %>"><%= a.actif?'Actif':'Inactif' %></span></div><% }) %><% if (!agents.length) { %><p class="muted">Aucun agent enregistré.</p><% } %></section></div>
<%- include("../partials/foot") %>
