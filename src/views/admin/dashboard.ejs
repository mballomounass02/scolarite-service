<%- include("../partials/head", {title}) %>
<div class="page-heading"><div><div class="eyebrow">PILOTAGE DE LA PLATEFORME</div><h1>Vue <em>d'ensemble.</em></h1><p>Suivez l'activité du service de scolarité.</p></div><a class="btn btn-primary" href="/admin/agents">＋ Gérer les agents</a></div>
<div class="stat-grid"><div class="stat-card"><span class="stat-label">ÉTUDIANTS</span><strong><%= counts.etudiants %></strong><small>Comptes enregistrés</small></div><div class="stat-card"><span class="stat-label">AGENTS</span><strong><%= counts.agents %></strong><small>Comptes du service</small></div><div class="stat-card"><span class="stat-label">DOSSIERS</span><strong><%= counts.dossiers %></strong><small>Demandes enregistrées</small></div></div>
<div class="two-col"><section class="panel"><h2>Dossiers par état</h2><% const total=states.reduce((s,x)=>s+Number(x.total),0)||1; %><% ['en attente','validé','rejeté'].forEach(et=>{ const row=states.find(x=>x.etat===et); const n=row?Number(row.total):0; %><div class="bar-row"><div><span><%= et %></span><b><%= n %></b></div><div class="bar-track"><i style="width:<%= n/total*100 %>%"></i></div></div><% }) %></section>
<section class="panel"><h2>Dossiers par filière</h2><% if (!filieres.length) { %><p class="muted">Aucune donnée disponible.</p><% } %><% filieres.forEach(f=>{ %><div class="simple-row"><span><%= f.filiere %></span><b><%= f.total %></b></div><% }) %></section></div>
<%- include("../partials/foot") %>
