<%- include("../partials/head", {title}) %>
<div class="page-heading"><div><div class="eyebrow">SERVICE DE LA SCOLARITÉ</div><h1>Gestion des <em>dossiers.</em></h1><p>Consultez, filtrez et traitez les demandes d'inscription.</p></div></div>
<section class="panel"><form method="get" class="filters"><label>État<select name="etat"><option value="">Tous les états</option><% ['en attente','validé','rejeté'].forEach(s=>{ %><option <%= filters.etat===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Filière<select name="filiere"><option value="">Toutes les filières</option><% filieres.forEach(f=>{ %><option <%= filters.filiere===f?'selected':'' %>><%= f %></option><% }) %></select></label><button class="btn btn-dark">Filtrer</button><a class="text-link" href="/agent">Réinitialiser</a></form>
<div class="table-wrap"><table><thead><tr><th>ÉTUDIANT</th><th>N° ÉTUDIANT</th><th>ANNÉE</th><th>FILIÈRE</th><th>NIVEAU</th><th>ÉTAT</th><th></th></tr></thead><tbody><% dossiers.forEach(d=>{ %><tr><td><b><%= d.prenom %> <%= d.nom %></b></td><td><%= d.numero_etudiant %></td><td><%= d.annee %></td><td><%= d.filiere %></td><td><%= d.niveau %></td><td><span class="status <%= d.etat==='validé'?'ok':d.etat==='rejeté'?'no':'wait' %>"><%= d.etat %></span></td><td><a class="table-link" href="/agent/dossiers/<%= d.id %>">Examiner →</a></td></tr><% }) %></tbody></table></div>
<% if (!dossiers.length) { %><div class="empty"><h3>Aucun dossier trouvé</h3><p>Modifiez les filtres pour élargir la recherche.</p></div><% } %></section>
<%- include("../partials/foot") %>
