<%- include("../partials/head", {title}) %>
<div class="page-heading"><div><a class="back-link" href="/agent">← Liste des dossiers</a><div class="eyebrow">EXAMEN DU DOSSIER</div><h1><em><%= dossier.prenom %> <%= dossier.nom %></em></h1><p><%= dossier.numero_etudiant %> · <%= dossier.email %></p></div><span class="status large <%= dossier.etat==='validé'?'ok':dossier.etat==='rejeté'?'no':'wait' %>"><%= dossier.etat %></span></div>
<div class="two-col"><section class="panel"><h2>Documents transmis</h2><% if (!pieces.length) { %><p class="muted">Aucune pièce déposée pour ce dossier.</p><% } %><% pieces.forEach(p=>{ %><div class="document-row"><span class="doc-icon">DOC</span><div><b><%= p.type_piece %></b><small><%= p.nom_original %> · <%= (p.taille_octets/1024).toFixed(0) %> Ko</small></div><a href="/agent/pieces/<%= p.id %>">Télécharger ↓</a></div><% }) %></section>
<section class="panel"><h2>Décision de la scolarité</h2><form method="post" action="/agent/dossiers/<%= dossier.id %>/decision" class="form-stack"><label>Décision<select name="etat"><option value="en attente" <%= dossier.etat==='en attente'?'selected':'' %>>En attente</option><option value="validé" <%= dossier.etat==='validé'?'selected':'' %>>Valider le dossier</option><option value="rejeté" <%= dossier.etat==='rejeté'?'selected':'' %>>Rejeter le dossier</option></select></label><label>Commentaire / motif<textarea name="commentaire" rows="5" placeholder="Précisez les éléments à corriger ou confirmez la validation..."><%= dossier.commentaire || '' %></textarea></label><button class="btn btn-primary btn-block">Enregistrer la décision</button></form></section></div>
<%- include("../partials/foot") %>
