<%- include("../partials/head", {title}) %>
<div class="page-heading"><div><div class="eyebrow">ESPACE ÉTUDIANT</div><h1>Bonjour <em><%= currentUser.prenom %></em>,</h1><p>Retrouvez ici vos demandes d'inscription et leur état d'avancement.</p></div><a class="btn btn-primary" href="/etudiant/nouveau-dossier">＋ Nouveau dossier</a></div>
<div class="stat-grid"><div class="stat-card"><span class="stat-label">MES DOSSIERS</span><strong><%= dossiers.length %></strong><small>Toutes années confondues</small></div><div class="stat-card"><span class="stat-label">EN ATTENTE</span><strong><%= dossiers.filter(d=>d.etat==='en attente').length %></strong><small>En cours de traitement</small></div><div class="stat-card"><span class="stat-label">VALIDÉS</span><strong><%= dossiers.filter(d=>d.etat==='validé').length %></strong><small>Inscriptions confirmées</small></div></div>
<section class="panel"><div class="section-head"><div><h2>Mes dossiers</h2><p class="muted">Historique de vos demandes d'inscription</p></div></div>
<% if (!dossiers.length) { %><div class="empty"><div class="empty-icon">▤</div><h3>Aucun dossier pour le moment</h3><p>Commencez par créer votre demande d'inscription annuelle.</p><a class="btn btn-primary" href="/etudiant/nouveau-dossier">Créer un dossier</a></div><% } else { %>
<div class="table-wrap"><table><thead><tr><th>ANNÉE</th><th>FILIÈRE</th><th>NIVEAU</th><th>PIÈCES</th><th>ÉTAT</th><th></th></tr></thead><tbody><% dossiers.forEach(d=>{ %><tr><td><b><%= d.annee %></b></td><td><%= d.filiere %></td><td><%= d.niveau %></td><td><%= d.nb_pieces %> document(s)</td><td><span class="status <%= d.etat==='validé'?'ok':d.etat==='rejeté'?'no':'wait' %>"><%= d.etat %></span></td><td><a class="table-link" href="/etudiant/dossiers/<%= d.id %>">Détails →</a></td></tr><% }) %></tbody></table></div><% } %></section>
<%- include("../partials/foot") %>
