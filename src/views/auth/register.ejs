<%- include("../partials/head", {title}) %>
<div class="form-page"><div class="form-heading"><div class="eyebrow">NOUVEAU COMPTE</div><h1>Créer votre espace<br><em>étudiant.</em></h1><p>Complétez les informations ci-dessous pour accéder au portail de scolarité.</p></div>
<form method="post" action="/inscription" class="panel form-grid">
<label>Numéro étudiant<input name="numero_etudiant" required maxlength="40" placeholder="Ex. US2026001"></label>
<label>Adresse e-mail<input type="email" name="email" required placeholder="vous@exemple.com"></label>
<label>Nom<input name="nom" required></label><label>Prénom<input name="prenom" required></label>
<label>Filière<input name="filiere" required placeholder="Ex. Systèmes d'information"></label>
<label>Niveau<select name="niveau" required><option value="">Choisir...</option><option>Licence 1</option><option>Licence 2</option><option>Licence 3</option><option>Master 1</option><option>Master 2</option></select></label>
<label>Mot de passe<input type="password" name="password" required minlength="8"></label>
<label>Confirmer le mot de passe<input type="password" name="password_confirm" required minlength="8"></label>
<div class="form-actions"><a class="text-link" href="/connexion">J'ai déjà un compte</a><button class="btn btn-primary">Créer mon compte →</button></div>
</form></div>
<%- include("../partials/foot") %>
